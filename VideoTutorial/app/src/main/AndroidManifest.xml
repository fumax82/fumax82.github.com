<?xml version="1.0" encoding="utf-8"?>
<!--
  Descrizione dell'app per Android: nome, icona, schermata iniziale.
  Il video e la cartella si scelgono con le finestre di sistema, che danno
  all'app l'accesso solo a quei file. Permessi: microfono (per dettare i
  commenti) e internet (per la trascrizione del parlato).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet: serve per la trascrizione del parlato con il servizio Groq -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microfono: serve solo per dettare i commenti (chiesto la prima volta) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Permette di trovare il servizio di riconoscimento vocale del telefono -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nome_app"
        android:supportsRtl="true"
        android:theme="@style/Tema.VideoTutorial">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
