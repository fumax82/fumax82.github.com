<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
  <FrameLayout android:layout_width="20dp" android:layout_height="match_parent" android:layout_marginRight="0dp">
    <ImageView android:id="@+id/r_mo_ln" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:color/transparent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <FrameLayout android:layout_gravity="center_horizontal|center_vertical" android:id="@+id/r_mo_pill" android:background="@drawable/w_pill_ring" android:padding="2dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
      <ImageView android:id="@+id/r_mo_pbg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_pill" android:scaleType="fitXY" android:importantForAccessibility="no"/>
      <TextView android:textSize="8.5sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:gravity="center_horizontal|center_vertical" android:id="@+id/r_mo" android:paddingLeft="2dp" android:paddingTop="4dp" android:paddingRight="2dp" android:paddingBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="13dp" android:includeFontPadding="false" android:lineSpacingMultiplier="0.900000"/>
    </FrameLayout>
  </FrameLayout>
  <FrameLayout android:layout_width="20dp" android:layout_height="match_parent" android:layout_marginRight="6dp">
    <ImageView android:id="@+id/r_wk_ln" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:color/transparent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <FrameLayout android:layout_gravity="center_horizontal|center_vertical" android:id="@+id/r_wk_pill" android:background="@drawable/w_pill_ring" android:padding="2dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
      <ImageView android:id="@+id/r_wk_pbg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_pill" android:scaleType="fitXY" android:importantForAccessibility="no"/>
      <TextView android:textSize="8.5sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:gravity="center_horizontal|center_vertical" android:id="@+id/r_wk" android:paddingLeft="2dp" android:paddingTop="4dp" android:paddingRight="2dp" android:paddingBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="13dp" android:includeFontPadding="false" android:lineSpacingMultiplier="0.900000"/>
    </FrameLayout>
  </FrameLayout>
  <FrameLayout android:id="@+id/r_ev" android:background="@drawable/w_row_bg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:layout_weight="1.000000">
    <ImageView android:id="@+id/r_glow" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_row_glow" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="9dp" android:paddingTop="6dp" android:paddingRight="8dp" android:paddingBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp">
      <ImageView android:id="@+id/r_bar" android:layout_width="3dp" android:layout_height="30dp" android:src="@drawable/w_bar" android:scaleType="fitXY" android:importantForAccessibility="no"/>
      <TextView android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/r_time" android:paddingLeft="9dp" android:layout_width="52dp" android:layout_height="wrap_content" android:maxLines="2" android:lineSpacingMultiplier="1.050000" android:fontFamily="sans-serif-medium"/>
      <LinearLayout android:orientation="vertical" android:paddingRight="4dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.000000">
        <TextView android:textSize="14.5sp" android:textColor="#FFFFFFFF" android:ellipsize="end" android:id="@+id/r_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/r_loc" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:textSize="11sp" android:textColor="#9EFFFFFF" android:ellipsize="end" android:id="@+id/r_meta" android:paddingTop="2dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1"/>
        <ProgressBar android:id="@+id/r_lp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:layout_marginRight="8dp" android:max="100" android:progressDrawable="@drawable/w_prog" style="?android:attr/progressBarStyleHorizontal"/>
      </LinearLayout>
      <ImageView android:id="@+id/r_list" android:padding="5dp" android:visibility="gone" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/w_li_todo" android:contentDescription="@string/w_list_open"/>
      <TextView android:textSize="9.5sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:id="@+id/r_badge" android:background="@drawable/w_badge_bg" android:paddingLeft="7dp" android:paddingTop="2dp" android:paddingRight="7dp" android:paddingBottom="2dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:letterSpacing="0.060000"/>
      <TextView android:id="@+id/r_place" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      <TextView android:textSize="15sp" android:gravity="center_horizontal|center_vertical" android:id="@+id/r_fam" android:background="@drawable/w_fam_bg" android:visibility="gone" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginLeft="6dp" android:includeFontPadding="false" android:importantForAccessibility="no"/>
    </LinearLayout>
  </FrameLayout>
</LinearLayout>
