<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/widget_img" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@string/widget_name"/>
  <LinearLayout android:orientation="vertical" android:paddingLeft="12dp" android:paddingTop="12dp" android:paddingRight="12dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4dp" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginBottom="4dp">
      <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/w_titlebox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.000000">
        <TextView android:textSize="19sp" android:textColor="#FFFFFFFF" android:ellipsize="end" android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:shadowColor="#80000000" android:shadowDy="1.000000" android:shadowRadius="3.000000" android:fontFamily="sans-serif-medium"/>
        <TextView android:textSize="11.5sp" android:textColor="#B8FFFFFF" android:ellipsize="end" android:id="@+id/w_sub" android:paddingTop="1dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:shadowColor="#80000000" android:shadowDy="1.000000" android:shadowRadius="3.000000"/>
      </LinearLayout>
      <TextView android:textSize="15sp" android:id="@+id/w_music" android:text="♪" style="@style/WBtn"/>
      <ImageView android:id="@+id/w_filter" android:padding="9.5dp" android:src="@drawable/w_ic_filter" android:scaleType="fitCenter" android:contentDescription="@string/wf_title" style="@style/WBtn"/>
      <TextView android:textSize="14sp" android:id="@+id/w_mode" android:text="▦" style="@style/WBtn"/>
      <TextView android:textSize="22sp" android:textStyle="normal" android:id="@+id/w_add" android:background="@drawable/w_btn_add" android:text="+" android:fontFamily="sans-serif-light" style="@style/WBtn"/>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/w_lbar" android:background="@drawable/w_lbar_bg" android:paddingLeft="8dp" android:paddingRight="10dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginBottom="6dp">
      <ImageView android:id="@+id/w_lbar_ic" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/w_li_doing" android:importantForAccessibility="no"/>
      <TextView android:textSize="12.5sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:ellipsize="end" android:id="@+id/w_lbar_t" android:paddingLeft="8dp" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:shadowColor="#80000000" android:shadowDy="1.000000" android:shadowRadius="3.000000" android:layout_weight="1.000000"/>
      <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFD27A" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.000000">
      <ListView android:id="@+id/w_list" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp"/>
      <TextView android:textSize="13sp" android:textColor="#F2FFFFFF" android:gravity="center_horizontal|center_vertical" android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:shadowColor="#80000000" android:shadowDy="1.000000" android:shadowRadius="3.000000"/>
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
