<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient android:startColor="#4D101830" android:endColor="#66101830" android:angle="270.000000"/>
      <corners android:radius="16dp"/>
    </shape>
  </item>
  <item android:bottom="20dp">
    <shape android:shape="rectangle">
      <gradient android:startColor="#1AFFFFFF" android:endColor="#00FFFFFF" android:angle="270.000000"/>
      <corners android:topLeftRadius="16dp" android:topRightRadius="16dp"/>
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="16dp"/>
      <stroke android:width="1dp" android:color="#2EFFFFFF"/>
    </shape>
  </item>
</layer-list>
